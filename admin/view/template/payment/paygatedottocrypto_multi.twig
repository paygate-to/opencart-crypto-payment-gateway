{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-payment" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <div class="alert alert-info"><i class="fa-solid fa-circle-info"></i> {{ text_intro }}</div>
        <form id="form-payment" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label for="input-title" class="col-sm-2 col-form-label">{{ entry_title }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_paygatedottocrypto_multi_title" value="{{ payment_paygatedottocrypto_multi_title }}" placeholder="{{ text_default_title }}" id="input-title" class="form-control"/>
              <div id="error-title" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-description" class="col-sm-2 col-form-label">{{ entry_description }}</label>
            <div class="col-sm-10">
              <textarea name="payment_paygatedottocrypto_multi_description" rows="3" placeholder="{{ entry_description }}" id="input-description" class="form-control">{{ payment_paygatedottocrypto_multi_description }}</textarea>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-checkout-domain" class="col-sm-2 col-form-label">{{ entry_checkout_domain }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_paygatedottocrypto_multi_checkout_domain" value="{{ payment_paygatedottocrypto_multi_checkout_domain }}" placeholder="checkout.paygate.to" id="input-checkout-domain" class="form-control"/>
              <div class="form-text">{{ help_checkout_domain }}</div>
              <div id="error-checkout-domain" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-api-domain" class="col-sm-2 col-form-label">{{ entry_api_domain }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_paygatedottocrypto_multi_api_domain" value="{{ payment_paygatedottocrypto_multi_api_domain }}" placeholder="api.paygate.to" id="input-api-domain" class="form-control"/>
              <div class="form-text">{{ help_api_domain }}</div>
              <div id="error-api-domain" class="invalid-feedback"></div>
            </div>
          </div>
          <fieldset>
            <legend>{{ text_wallets }}</legend>
            <div class="form-text mb-3">{{ help_wallets }}</div>
            {% for wallet in wallets %}
              <div class="row mb-3">
                <label for="input-wallet-{{ wallet.family }}" class="col-sm-2 col-form-label">{{ wallet.label }}</label>
                <div class="col-sm-10">
                  <input type="text" name="payment_paygatedottocrypto_multi_wallet_{{ wallet.family }}" value="{{ wallet.value|e }}" id="input-wallet-{{ wallet.family }}" class="form-control" autocomplete="off" spellcheck="false"/>
                  <div id="error-wallet-{{ wallet.family }}" class="invalid-feedback"></div>
                </div>
              </div>
            {% endfor %}
          </fieldset>
          <div class="row mb-3">
            <label for="input-tolerance" class="col-sm-2 col-form-label">{{ entry_tolerance }}</label>
            <div class="col-sm-10">
              <select name="payment_paygatedottocrypto_multi_tolerance" id="input-tolerance" class="form-select">
                {% for value, label in tolerances %}
                  <option value="{{ value }}"{% if value == payment_paygatedottocrypto_multi_tolerance %} selected{% endif %}>{{ label }}</option>
                {% endfor %}
              </select>
              <div class="form-text">{{ help_tolerance }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_fees }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="payment_paygatedottocrypto_multi_fees" value="0"/>
                <input type="checkbox" name="payment_paygatedottocrypto_multi_fees" value="1" id="input-fees" class="form-check-input"{% if payment_paygatedottocrypto_multi_fees %} checked{% endif %}/>
              </div>
              <div class="form-text">{{ help_fees }}</div>
            </div>
          </div>
          <fieldset>
            <legend>{{ text_branding }}</legend>
            <div class="row mb-3">
              <label for="input-logo" class="col-sm-2 col-form-label">{{ entry_logo }}</label>
              <div class="col-sm-10">
                <input type="text" name="payment_paygatedottocrypto_multi_logo" value="{{ payment_paygatedottocrypto_multi_logo|e }}" placeholder="https://" id="input-logo" class="form-control"/>
                <div class="form-text">{{ help_logo }}</div>
                <div id="error-logo" class="invalid-feedback"></div>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-background-color" class="col-sm-2 col-form-label">{{ entry_background_color }}</label>
              <div class="col-sm-10">
                <input type="text" name="payment_paygatedottocrypto_multi_background_color" value="{{ payment_paygatedottocrypto_multi_background_color }}" placeholder="#ffffff" id="input-background-color" class="form-control"/>
                <div class="form-text">{{ help_color }}</div>
                <div id="error-background-color" class="invalid-feedback"></div>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-theme-color" class="col-sm-2 col-form-label">{{ entry_theme_color }}</label>
              <div class="col-sm-10">
                <input type="text" name="payment_paygatedottocrypto_multi_theme_color" value="{{ payment_paygatedottocrypto_multi_theme_color }}" placeholder="#1d4ed8" id="input-theme-color" class="form-control"/>
                <div class="form-text">{{ help_color }}</div>
                <div id="error-theme-color" class="invalid-feedback"></div>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-button-color" class="col-sm-2 col-form-label">{{ entry_button_color }}</label>
              <div class="col-sm-10">
                <input type="text" name="payment_paygatedottocrypto_multi_button_color" value="{{ payment_paygatedottocrypto_multi_button_color }}" placeholder="#1d4ed8" id="input-button-color" class="form-control"/>
                <div class="form-text">{{ help_color }}</div>
                <div id="error-button-color" class="invalid-feedback"></div>
              </div>
            </div>
          </fieldset>
          <div class="row mb-3">
            <label for="input-order-status" class="col-sm-2 col-form-label">{{ entry_order_status }}</label>
            <div class="col-sm-10">
              <select name="payment_paygatedottocrypto_multi_order_status_id" id="input-order-status" class="form-select">
                {% for order_status in order_statuses %}
                  <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_paygatedottocrypto_multi_order_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
              <div class="form-text">{{ help_order_status }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-paid-status" class="col-sm-2 col-form-label">{{ entry_paid_status }}</label>
            <div class="col-sm-10">
              <select name="payment_paygatedottocrypto_multi_paid_status_id" id="input-paid-status" class="form-select">
                {% for order_status in order_statuses %}
                  <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_paygatedottocrypto_multi_paid_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-failed-status" class="col-sm-2 col-form-label">{{ entry_failed_status }}</label>
            <div class="col-sm-10">
              <select name="payment_paygatedottocrypto_multi_failed_status_id" id="input-failed-status" class="form-select">
                {% for order_status in order_statuses %}
                  <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_paygatedottocrypto_multi_failed_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-geo-zone" class="col-sm-2 col-form-label">{{ entry_geo_zone }}</label>
            <div class="col-sm-10">
              <select name="payment_paygatedottocrypto_multi_geo_zone_id" id="input-geo-zone" class="form-select">
                <option value="0">{{ text_all_zones }}</option>
                {% for geo_zone in geo_zones %}
                  <option value="{{ geo_zone.geo_zone_id }}"{% if geo_zone.geo_zone_id == payment_paygatedottocrypto_multi_geo_zone_id %} selected{% endif %}>{{ geo_zone.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="payment_paygatedottocrypto_multi_status" value="0"/>
                <input type="checkbox" name="payment_paygatedottocrypto_multi_status" value="1" id="input-status" class="form-check-input"{% if payment_paygatedottocrypto_multi_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-sort-order" class="col-sm-2 col-form-label">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_paygatedottocrypto_multi_sort_order" value="{{ payment_paygatedottocrypto_multi_sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control"/>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
